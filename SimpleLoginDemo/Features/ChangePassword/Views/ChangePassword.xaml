<Window x:Class="SimpleLoginDemo.Features.ChangePassword.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleLoginDemo.Features.ChangePassword.Views" xmlns:controls="clr-namespace:SimpleLoginDemo.Shared.Controls"
        mc:Ignorable="d"
        Title="ChangePassword" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="修改密码" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="用户名:" Margin="10"/>
                <TextBox Width="200" Margin="10" Text="{Binding UserName}"></TextBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="旧密码:" Margin="10"/>
                <controls:BindablePasswordBox Password="{Binding PassWord}" Width="200" Margin="10"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="新密码:" Margin="10"/>
                <controls:BindablePasswordBox Password="{Binding NewPassWord}" Width="200" Margin="10"/>
            </StackPanel>
        </Grid>
        <Button Grid.Row="2" Content="修改密码" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ChangePasswordCommand}"/>
    </Grid>
</Window>

<UserControl x:Class="SimpleLoginDemo.Shared.Controls.BindablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="220">
    <Grid>
        <!--
            PasswordBox 的 Password 不能像 TextBox.Text 那样直接做普通双向绑定。
            所以这里包了一层简单控件，对外提供一个可绑定的 Password 属性。

            这不是 CommunityToolkit.Mvvm 的职责范围，
            而是 WPF 控件本身的一个特殊点。
        -->
        <PasswordBox x:Name="InnerPasswordBox"
                     Padding="8"
                     FontSize="14"
                     PasswordChanged="InnerPasswordBox_OnPasswordChanged" />
    </Grid>
</UserControl>
